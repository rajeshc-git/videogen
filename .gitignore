# Media directories (User uploads and generated outputs - preserve folders via .gitkeep)
uploads/*
!uploads/.gitkeep
outputs/*
!outputs/.gitkeep

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.env
.venv
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Operating System files
Thumbs.db
Desktop.ini
.DS_Store
*.tmp
*.part
